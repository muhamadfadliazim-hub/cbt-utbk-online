generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
  PARENT
}

enum ExamType {
  SNBT
  UTBK
  TKA_SD
  TKA_SMP
  TKA_SMA
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamAccess {
  OPEN
  EXCLUSIVE
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

model User {
  id              String            @id @default(cuid())
  name            String?
  email           String?           @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  role            Role              @default(STUDENT)
  isApproved      Boolean           @default(false)
  snbpTargetUniv  String?
  snbpTargetMajor String?
  schoolName      String?
  isPremium       Boolean           @default(false)
  allowedExamTypes ExamType[]
  parentId        String? // For students to link to parents
  parent          User?             @relation("ParentStudent", fields: [parentId], references: [id])
  children        User[]            @relation("ParentStudent")
  
  accounts        Account[]
  sessions        Session[]

  attempts        Attempt[]
  reportCards     ReportCard[]
  progress        StudentProgress[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Exam {
  id               String    @id @default(cuid())
  title            String
  description      String?
  type             ExamType
  status           ExamStatus @default(DRAFT)
  access           ExamAccess @default(EXCLUSIVE)
  totalDuration    Int // in minutes
  scheduledAt      DateTime?
  publishedAt      DateTime?
  targetSchools    String[]
  targetUsers      String[]
  showDiscussion   Boolean   @default(false)
  allowPdfDownload Boolean   @default(false)
  sections         Section[]
  attempts         Attempt[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Section {
  id              String     @id @default(cuid())
  examId          String
  exam            Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  durationMinutes Int
  orderIndex      Int
  questions       Question[]
}

enum QuestionType {
  PILIHAN_GANDA // Standard multiple choice (1 correct answer)
  PG_KOMPLEKS // Multiple correct answers (checkboxes)
  BENAR_SALAH // True or False (or similar binary choices)
  MENJODOHKAN // Matching left and right columns
  ISIAN_SINGKAT // Exact short string matching
  URAIAN // Essay, requires manual or AI grading
}

model Question {
  id                   String       @id @default(cuid())
  sectionId            String
  section              Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type                 QuestionType @default(PILIHAN_GANDA)
  content              String // JSON or Markdown for complex content
  options              String // JSON array of options or matching pairs
  answerKey            String // The correct option, array of options, or matching pairs
  explanation          String?
  // IRT Parameters
  difficultyParameter  Float        @default(0) // b-parameter: lower is easier, higher is harder
  discriminationIndex  Float        @default(1) // a-parameter: ability to distinguish high/low students
  guessingParameter    Float        @default(0.2) // c-parameter: probability of guessing correctly
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Attempt {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  startTime DateTime  @default(now())
  endTime   DateTime?
  score     Float?
  answers   String // JSON storing student's answers
}

model ReportCard {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester1        Float?
  semester2        Float?
  semester3        Float?
  semester4        Float?
  semester5        Float?
  targetUniversity String?
  targetMajor      String?
  predictionScore  Float?
  updatedAt        DateTime @updatedAt
}

model University {
  id        String   @id @default(cuid())
  name      String   @unique
  majors    Major[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Major {
  id                String     @id @default(cuid())
  universityId      String
  university        University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name              String
  category          String     // SAINTEK or SOSHUM
  snbpTightness     Float?     // Percentage, nullable for new programs without applicant data
  snbtPassingGrade  Float?     // Predicted IRT target; not an official SNPMB passing grade
  
  @@unique([universityId, name])
}

// -----------------------------------------------------------------------------
// Learning Management System (LMS) Models
// -----------------------------------------------------------------------------

model Subject {
  id          String    @id @default(cuid())
  title       String    @unique
  description String?
  icon        String?   // Lucide icon name or URL
  color       String?   // Hex code for UI styling
  chapters    Chapter[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Chapter {
  id          String     @id @default(cuid())
  subjectId   String
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  orderIndex  Int
  materials   Material[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum MaterialType {
  VIDEO
  PDF
  ARTICLE
}

model Material {
  id          String        @id @default(cuid())
  chapterId   String
  chapter     Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        MaterialType  @default(VIDEO)
  url         String        // YouTube embed URL or PDF storage link
  duration    Int?          // Duration in minutes
  orderIndex  Int
  examType    ExamType?
  isPublished Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model StudentProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId  String
  completedAt DateTime  @default(now())
  
  @@unique([userId, materialId])
}

// Broadcasts created by admins and shown on student dashboards/exam catalogs.
// A null audience means the announcement applies to every exam track.
model Announcement {
  id          String               @id @default(cuid())
  title       String
  message     String
  audience    ExamType?
  priority    AnnouncementPriority @default(NORMAL)
  publishedAt DateTime             @default(now())
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model LiveClass {
  id           String   @id @default(cuid())
  title        String
  description  String?
  scheduledAt  DateTime
  roomName     String   @unique
  isActive     Boolean  @default(true)
  targetSchool String?
  targetUserEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
